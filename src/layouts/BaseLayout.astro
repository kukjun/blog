---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import { IDENTITY } from '../siteconfig';
import { t, withBase, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}
const { lang, title, description } = Astro.props;
const tr = t(lang);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={`RSS (${lang})`} href={withBase(`/rss-${lang}.xml`)} />
    <!-- FOUC 방지: 저장된 테마 즉시 적용 -->
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('theme');
          if (s) document.documentElement.setAttribute('data-theme', s);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Header lang={lang} />
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap footwrap">
        <Contact />
        <div class="footmeta">{IDENTITY.displayName} · {tr.role} · © {year}</div>
      </div>
    </footer>
    <script is:inline>
      // mermaid 다이어그램 렌더 (페이지에 .mermaid 있을 때만 CDN 로드).
      // GitHub Pages는 CSP 제약 없음. 테마 토글 시 재렌더.
      (function () {
        if (!document.querySelector('.mermaid')) return;
        function theme() {
          var t = document.documentElement.getAttribute('data-theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          return t;
        }
        import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')
          .then(function (mod) {
            var mermaid = mod.default;
            function render() {
              document.querySelectorAll('.mermaid').forEach(function (el) {
                if (el.dataset.src) el.innerHTML = el.dataset.src;
                else el.dataset.src = el.innerHTML;
                el.removeAttribute('data-processed');
              });
              mermaid.initialize({
                startOnLoad: false,
                theme: theme() === 'dark' ? 'dark' : 'default',
                securityLevel: 'loose',
                fontFamily: 'ui-monospace, monospace',
              });
              mermaid.run({ querySelector: '.mermaid' });
            }
            render();
            new MutationObserver(render).observe(document.documentElement, {
              attributes: true, attributeFilter: ['data-theme'],
            });
          })
          .catch(function () {/* 오프라인이면 코드로 보임 */});
      })();
    </script>
  </body>
</html>
