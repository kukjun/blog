---
import { IDENTITY } from '../siteconfig';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<nav class:list={['contact', { compact }]} aria-label="contact">
  <a href={IDENTITY.github} target="_blank" rel="me noopener">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.575.106.785-.25.785-.556 0-.274-.01-1-.015-1.964-3.196.695-3.87-1.54-3.87-1.54-.523-1.33-1.276-1.684-1.276-1.684-1.043-.713.08-.699.08-.699 1.153.081 1.76 1.184 1.76 1.184 1.026 1.758 2.693 1.25 3.35.955.104-.743.401-1.25.73-1.538-2.552-.29-5.236-1.276-5.236-5.68 0-1.255.448-2.28 1.183-3.084-.119-.29-.513-1.46.112-3.043 0 0 .965-.309 3.163 1.178a11 11 0 0 1 5.76 0c2.196-1.487 3.16-1.178 3.16-1.178.626 1.583.232 2.753.114 3.043.737.804 1.182 1.829 1.182 3.084 0 4.415-2.688 5.386-5.248 5.67.413.355.78 1.056.78 2.128 0 1.537-.014 2.776-.014 3.153 0 .309.207.668.79.555A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
    <span>GitHub</span>
  </a>
  <a href={IDENTITY.linkedin} target="_blank" rel="me noopener">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"/></svg>
    <span>LinkedIn</span>
  </a>
  <a href={`mailto:${IDENTITY.email}`} rel="me">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M2 4h20a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm10 7.2L3.3 5.5h17.4L12 11.2Zm0 2.35L3 7.9V18h18V7.9l-9 5.65Z"/></svg>
    <span>Email</span>
  </a>
</nav>
<style>
  .contact { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
  .contact a {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--ink-dim); font-family: var(--font-mono);
    font-size: .8rem; letter-spacing: .02em;
  }
  .contact a:hover { color: var(--accent); text-decoration: none; }
  .contact svg { display: block; }
  .contact.compact a span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .contact.compact { gap: 14px; }
</style>
